@model IEnumerable<MusicStore.Models.CartItem>

@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4 px-3 py-2 animate-fade-in">
    <h2 class="fw-bold text-dark mb-2">Shopping Cart</h2>

    <p class="text-muted m-0 mt-1 mb-3">
        <span id="lblTotalCount" class="">@ViewBag.TotalCount</span>
        <span id="lblItemText">@((ViewBag.TotalCount <= 1) ? "item" : "items")</span> in your cart
    </p>

    @if (Model != null && Model.Any())
    {
        <button id="btnClearCart" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
            <i class="bi bi-trash3 me-1"></i> Remove All
        </button>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle">
                        <thead>
                            <tr class="text-muted small text-uppercase border-bottom">
                                <th style="width: 40%">Product</th>
                                <th style="width: 20%">Price</th>
                                <th style="width: 20%">Quantity</th>
                                <th style="width: 15%">Total</th>
                                <th style="width: 5%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom cart-row-item" data-id="@item.ProductId">
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div style="width: 65px; height: 65px; border-radius: 12px; overflow:hidden;" class="bg-light shadow">
                                                <img src="@Url.Content("~/Images/" + item.Product.ImageUrl)" class="w-100 h-100 object-cover" />
                                            </div>
                                            <div>
                                                <h6 class="fw-semibold text-dark m-0">@item.Product.ProductName</h6>
                                                <small class="text-muted">@item.Product.BrandName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>$@string.Format("{0:N2}", item.Product.UnitPrice)</td>
                                    <td>
                                        <div class="input-group bg-light border rounded-pill overflow-hidden p-0.5" style="max-width: 110px; height:34px;">
                                            <button class="btn btn-sm btn-cart-minus border-0 bg-transparent text-secondary p-0 px-2" type="button"><i class="bi bi-dash"></i></button>
                                            <input type="number" class="form-control btn-sm border-0 text-center fw-semibold text-dark p-0 ps-2 input-cart-qty bg-transparent" value="@item.Quantity" min="1" max="@item.Product.StockQuantity" readonly />
                                            <button class="btn btn-sm btn-cart-plus border-0 bg-transparent text-secondary p-0 px-2 ps-0" type="button"><i class="bi bi-plus"></i></button>
                                        </div>

                                    </td>
                                    <td class="fw-semibold text-dark">$<span class="lbl-item-total">@string.Format("{0:N2}", (item.Quantity * item.Product.UnitPrice))</span></td>
                                    <td>
                                        <button class="btn btn-sm text-danger border-0 bg-transparent btn-remove-item" type="button">
                                            <i class="bi bi-trash3 fs-6"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-light p-4 rounded-4">
                    <h5 class="fw-bold text-dark mb-4">Order Summary</h5>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-secondary">Subtotal</span>
                        <span class="fs-4 fw-bold text-dark">$<span id="lblGrandTotal">@string.Format("{0:N2}", ViewBag.GrandTotal)</span></span>
                    </div>

                    <a href="@Url.Action("Checkout", "Orders")" class="btn w-100 py-2.5 fw-semibold shadow" style="border-radius: 50px; background-color: #f3a016; color:white;">
                        <i class="bi bi-credit-card"></i> &nbsp; Proceed to Checkout
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted d-block mb-3"></i>
            <h4 class="text-secondary">Your cart is empty</h4>
            <a href="@Url.Action("Index", "Home")" class="btn mt-3 px-4 py-2 fw-semibold" style="border-radius: 50px; background-color: #f3a016; border-color:#f3a016;color:white;">Continue Shopping</a>
        </div>
    }
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            function updateCartQuantity($row, newQty) {
                var productId = $row.data('id');

                $.ajax({
                    url: '@Url.Action("UpdateQuantity", "ShoppingCarts")',
                    type: 'POST',
                    data: { id: productId, qty: newQty },
                    success: function (response) {
                        if (response.success) {
                            $row.find('.lbl-item-total').text(response.itemTotalPrice);
                            $('#lblGrandTotal').text(response.grandTotal);
                            $('#cartBadge').text(response.cartCount);
                            $('#lblTotalCount').text(response.cartCount);

                            if (response.cartCount <= 1) {
                                $('#lblItemText').text('item');
                            } else {
                                $('#lblItemText').text('items');
                            }

                            if (newQty <= 0) {
                                $row.fadeOut(300, function() { $(this).remove(); checkCartEmpty(); });
                            }
                        } else {
                            alert(response.message);
                            location.reload();
                        }
                    }
                });
            }

            $('.btn-cart-minus').on('click', function () {
                var $row = $(this).closest('.cart-row-item');
                var $input = $row.find('.input-cart-qty');
                var currentVal = parseInt($input.val()) || 1;

                if (currentVal > 1) {
                    var newVal = currentVal - 1;
                    $input.val(newVal);
                    updateCartQuantity($row, newVal);
                }
            });

            $('.btn-cart-plus').on('click', function () {
                var $row = $(this).closest('.cart-row-item');
                var $input = $row.find('.input-cart-qty');
                var maxStock = parseInt($input.attr('max')) || 99;
                var currentVal = parseInt($input.val()) || 1;

                if (currentVal < maxStock) {
                    var newVal = currentVal + 1;
                    $input.val(newVal);
                    updateCartQuantity($row, newVal);
                } else {
                    alert("Số lượng sản phẩm vượt quá giới hạn tồn kho.");
                }
            });

            $('.btn-remove-item').on('click', function () {
                var $row = $(this).closest('.cart-row-item');
                var productId = $row.data('id');

                if (confirm("Bạn có chắc chắn muốn bỏ sản phẩm này?")) {
                    $.ajax({
                        url: '@Url.Action("RemoveFromCart", "ShoppingCarts")',
                        type: 'POST',
                        data: { id: productId },
                        success: function (response) {
                            if (response.success) {
                                $('#lblGrandTotal').text(response.grandTotal);
                                $('#lblTotalCount').text(response.cartCount);
                                $('#cartBadge').text(response.cartCount);

                                $row.fadeOut(300, function () {
                                    $(this).remove();
                                    checkCartEmpty();
                                });
                            }
                        }
                    });
                }
            });

            $('#btnClearCart').on('click', function () {
                if (confirm("Bạn có chắc chắn muốn xóa toàn bộ sản phẩm khỏi giỏ hàng không?")) {
                    $.ajax({
                        url: '@Url.Action("RemoveAllFromCart", "ShoppingCarts")',
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                $('#lblTotalCount').text('0');
                                $('#cartBadge').text('0');
                                $('#lblItemText').text('items');

                                $('.cart-row-item').fadeOut(400, function () {
                                    location.reload();
                                });
                            } else {
                                alert("Không thể xóa giỏ hàng: " + (response.message || "Lỗi chưa xác định"));
                            }
                        },
                        error: function () {
                            alert("Đã xảy ra lỗi hệ thống khi kết nối tới máy chủ.");
                        }
                    });
                }
            });

            function checkCartEmpty() {
                if ($('.cart-row-item').length === 0) {
                    location.reload();
                }
            }
        });
    </script>
}