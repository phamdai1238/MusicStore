@model IEnumerable<MusicStore.Models.Order>
@{
    ViewBag.Title = "Order History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5 animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-clock-history text-warning me-2"></i>Order History
        </h2>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left"></i> Continue Shopping
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-light rounded-4 border border-dashed">
            <i class="bi bi-bag-x text-muted display-1 mb-3"></i>
            <p class="text-secondary fs-5 mb-0">You have no order history yet.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase small">
                        <tr>
                            <th class="ps-4 py-3">Order Code</th>
                            <th class="py-3">Date Ordered</th>
                            <th class="py-3">Delivery Address</th>
                            <th class="py-3">Total Amount</th>
                            <th class="py-3 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr onclick="location.href='@Url.Action("MyOrderDetails", "Orders", new { id = order.OrderId })'" style="cursor: pointer;">
                                <td class="ps-4 fw-bold text-secondary">#@order.OrderId</td>

                                <td>
                                    @(order.OrderDate.HasValue ? order.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                </td>

                                <td>
                                    <span class="text-truncate d-block" style="max-width: 300px;">
                                        @order.ShippingAddress
                                    </span>
                                </td>

                                <td class="fw-bold text-danger">
                                    $@string.Format("{0:N2}", order.OrderTotalAmount)
                                </td>

                                <td class="text-center">
                                    @if (order.OrderStatus == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill">Pending</span>
                                    }
                                    else if (order.OrderStatus == "Shipping")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">Shipping</span>
                                    }
                                    else if (order.OrderStatus == "Delivered")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">Delivered</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 py-2 rounded-pill">Cancelled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>