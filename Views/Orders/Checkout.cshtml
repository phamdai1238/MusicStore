@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <h2 class="fw-bold mb-4 text-dark"><i class="bi bi-wallet2 me-2 text-warning"></i>Confirm your order</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger rounded-3">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
        </div>
    }

    <div class="row g-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="mb-3 fw-bold text-secondary">Delivery address</h4>

                @using (Html.BeginForm("Checkout", "Orders", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Recipient's full name</label>
                        <input type="text" class="form-control rounded-3" value="@Session["FullName"]" disabled />
                        <small class="text-muted">The system automatically retrieves your account information.</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Detailed delivery address <span class="text-danger">*</span></label>
                        <textarea name="shippingAddress" class="form-control rounded-3" rows="3" required placeholder="Nhập số nhà, tên đường, tỉnh thành...">@ViewBag.UserAddress</textarea>
                    </div>

                    <button type="submit" class="btn btn-lg w-100 fw-bold rounded-pill text-uppercase py-2 shadow-sm" style="background-color: #f3a016; color: white;">
                        <i class="bi bi-bag-check-fill me-2"></i> Order completed
                    </button>
                }
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light border-start border-4 border-warning">
                <h4 class="mb-3 fw-bold text-secondary">Summary of Value</h4>
                <div class="d-flex justify-content-between align-items-center my-3">
                    <span class="text-muted">Payment Method:</span>
                    <span class="badge bg-dark rounded-pill px-3 py-2">Cash on Delivery (COD)</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-4 fw-bold">Total Amount:</span>
                    <span class="fs-3 fw-bold text-danger">$@string.Format("{0:N2}", ViewBag.GrandTotal)</span>
                </div>
            </div>
        </div>
    </div>
</div>