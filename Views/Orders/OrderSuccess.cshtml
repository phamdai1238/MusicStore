@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5 text-center py-5 animate-fade-in">
    <div class="div-icon-success mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 6rem;"></i>
    </div>
    <h1 class="fw-bold text-dark mb-2"> Order successfully!</h1>
    <p class="text-secondary fs-5 mb-4">Thank you for shopping at MusicStore. Your order is being processed by our system.</p>

    <div class="d-flex justify-content-center gap-3">
        <a href="@Url.Action("Index", "Home")" class="btn btn-warning btn-md rounded-pill px-5 fw-bold shadow-sm" style="background-color: #f3a016; color: white;">
            <i class="bi bi-house-door me-2"></i> Back to Home
        </a>
        <a href="@Url.Action("MyOrders", "Orders")" class="btn btn-dark btn-md rounded-pill px-4 fw-semibold">
            <i class="bi bi-journal-text me-2"></i> View Order History
        </a>
    </div>
</div>