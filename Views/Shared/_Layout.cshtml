<!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewBag.Title - MusicStore</title>
        <link href="~/Content/Site.css"
              rel="stylesheet" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        @Styles.Render("~/Content/css")
        @Scripts.Render("~/bundles/modernizr")
    </head>

    <body>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand fw-bold fs-1" href="@Url.Action("Index","Home")">
                    Music<span class="text-warning">Store</span>
                </a>

                <!-- Search -->
                <div class="mx-auto">
                    <form class="d-flex" method="get" action="@Url.Action("Index","Products")">
                        <input class="form-control rounded-pill"
                               type="search"
                               name="search"
                               placeholder="Search products..." />
                    </form>

                </div>

                <!-- Right -->
                <div class="d-flex align-items-center">
                    @if (Session["UserName"] == null)
                    {
                        <a href="@Url.Action("Login","Users")"
                           class="btn btn-dark text-light rounded-pill px-3 ms-2 fw-bold">
                            Sign in
                        </a>
                        <a href="@Url.Action("Register","Users")"
                           class="btn rounded-pill px-4 ms-2 fw-bold"
                           style="background-color: #f59e0b; color:white">
                            Sign up
                        </a>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">

                            <!-- Cart -->
                            <a href="@Url.Action("Index","ShoppingCarts")"
                               class="position-relative text-dark me-4 fs-4">
                                <i class="bi bi-cart3"></i>

                                <span class="cart-badge" id="cartBadge">
                                    @(Session["CartCount"] ?? 0)
                                </span>
                            </a>

                            <!-- User Dropdown -->
                            <div class="dropdown">

                                <a href="#"
                                   class="d-flex align-items-center text-decoration-none"
                                   id="userDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-person-circle fs-5 text-primary me-2"></i>

                                    <span class=" text-dark">
                                        @Session["FullName"]
                                    </span>

                                </a>

                                <ul class="dropdown-menu shadow border-0 mt-2">

                                    <li>
                                        <a class="dropdown-item py-2"
                                           href="@Url.Action("Profile","Users")">
                                            <i class="bi bi-person me-2 text-secondary"></i>
                                            Profile
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2"
                                           href="@Url.Action("MyOrders", "Orders")">
                                            <i class="bi bi-bag me-2 text-secondary"></i>
                                            Orders
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2"
                                           href="@Url.Action("EditProfile","Users")">
                                            <i class="bi bi-gear me-2 text-secondary"></i>
                                            Setting
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item text-danger py-2"
                                           href="@Url.Action("Logout","Users")">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Log out
                                        </a>
                                    </li>

                                </ul>

                            </div>

                        </div>
                    }
                </div>

            </div>
        </nav>

        <div class="container body-content">
            @RenderBody()
            
        </div>

        <footer>
            <div class="footer mt-5">

                <!-- Newsletter -->
                <section class="newsletter py-5 border-top">
                    <div class="container text-center">

                        <h3 class="fw-bold mb-3">Stay in the loop</h3>

                        <p class="text-muted mb-4">
                            Subscribe to our newsletter for exclusive offers, new arrivals,
                            and style inspiration.
                        </p>
                        <form class="newsletter-form mx-auto">
                            <input type="email"
                                   class="form-control"
                                   placeholder="Enter your email" />
                            <button type="submit" class="btn-news">
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </form>

                    </div>
                </section>

                <!-- Main Footer -->
                <section class="footer-main py-5 border-top container body-content">
                    <div class="container">
                        <div class="row gy-5">
                            <!-- Left -->
                            <div class="col-lg-4">
                                <h2 class="footer-logo">
                                    Music<span>Store</span>
                                </h2>
                                <p class="text-muted mt-3">
                                    
                                </p>
                                <ul class="list-unstyled footer-contact mt-4">
                                    <li>
                                        <i class="bi bi-geo-alt"></i>
                                        123 Musical Street, Style City, SC 12345
                                    </li>
                                    <li>
                                        <i class="bi bi-telephone"></i>
                                        +1 (555) 123-4567
                                    </li>
                                    <li>
                                        <i class="bi bi-envelope"></i>
                                        hello@musicstore.com
                                    </li>
                                </ul>
                                <div class="social mt-4">
                                    <a href="#"><i class="bi bi-facebook"></i></a>
                                    <a href="#"><i class="bi bi-twitter"></i></a>
                                    <a href="#"><i class="bi bi-instagram"></i></a>
                                    <a href="#"><i class="bi bi-github"></i></a>
                                </div>
                            </div>

                            <!-- Shop -->
                            <div class="col-6 col-md-3 col-lg">
                                <h6>SHOP</h6>
                                <a style="display: block;" href="#">All Products</a>
                                <a style="display: block;" href="#">New Arrivals</a>
                                <a style="display: block;" href="#">Sale</a>
                                <a style="display: block;" href="#">Featured</a>
                            </div>

                            <!-- Customer -->
                            <div class="col-6 col-md-3 col-lg">
                                <h6>CUSTOMER CARE</h6>
                                <a style="display: block;" href="#">Contact Us</a>
                                <a style="display: block;" href="#">Help Center</a>
                                <a style="display: block;" href="#">Shipping Info</a>
                                <a style="display: block;" href="#">Returns & Exchanges</a>
                            </div>

                            <!-- Company -->
                            <div class="col-6 col-md-3 col-lg">
                                <h6>COMPANY</h6>
                                <a style="display: block;" href="#">About Us</a>
                                <a style="display: block;" href="#">Careers</a>
                                <a style="display: block;" href="#">Blog</a>
                                <a style="display: block;" href="#">Press</a>
                            </div>

                            <!-- Legal -->
                            <div class="col-6 col-md-3 col-lg">
                                <h6>LEGAL</h6>
                                <a style="display: block;" href="#">Privacy Policy</a>
                                <a style="display: block;" href="#">Terms & Conditions</a>
                                <a style="display: block;" href="#">Cookie Policy</a>
                                <a style="display: block;" href="#">Accessibility</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Bottom -->
                <section class="footer-bottom border-top py-4 container body-content">
                    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
                        <p class="mb-3 mb-md-0 text-muted">
                            © @DateTime.Now.Year - My MusicStore Application.
                        </p>
                        <div>
                            <a href="#">Privacy</a>
                            <a href="#">Terms</a>
                            <a href="#">Cookies</a>
                        </div>
                    </div>
                </section>
            </div>            
        </footer>

        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)
    </body>
    </html>
